# Copy to .env and fill in real values. Never commit real secrets.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# STS Reactivation System — Web Push. This is the PUBLIC VAPID key only —
# safe to expose client-side. See DEPLOYMENT.md "Generate VAPID keys" for
# how to generate the pair; the PRIVATE key never goes here or anywhere
# in this repository — it's a Supabase Edge Function secret only
# (VAPID_PRIVATE_KEY, set via `supabase secrets set`, never committed).
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Payments UI — disabled by default to prevent Edge Function traffic while Supabase is over quota.
VITE_PAYMENTS_UI_ENABLED=false

# Hosted dummy PSP — server-side only. NEVER use VITE_ prefix for these.
# Set via Supabase Edge Function secrets, not in .env.
# DUMMY_PROVIDER_BASE_URL=https://your-dummy-psp-host.a.run.app
# DUMMY_PROVIDER_API_KEY=your-api-key
# DUMMY_PROVIDER_WEBHOOK_SECRET=your-webhook-secret
